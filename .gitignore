.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-1/

# Node / Next.js
node_modules/
.next/

# Java / Maven
target/
*.class

# Logs / local artifacts
# Local working data. Everything the scripts write that is not source lives under .local/ (reports, snapshots, backups,
# logs, tmp, crawlernest-samples, snapshot_htmls), so the top level of a working copy stays the README files, the licence
# and four folders. The per-name rules below still apply wherever those names appear.
.local/
logs/
*.log
tmp/

# Operational automation outputs (generated at runtime)
snapshots/
snapshot_htmls/
reports/
# ...except the autoeval reports, which are curated evidence rather than runtime
# dumps. Three of them were already tracked; this stops the next one from being
# silently dropped.
!crawlernest/crawlernest-autoeval/reports/
backups/
agent_debug_report.docx

# Local diagnostics snapshot written by scripts/update_diagnostics.py (git status, test results, config
# templates). Never committed or pushed.
.repo-diagnostics/

# Runtime crawler artifacts
crawlernest/crawlernest-kb/databases/the_rankings_*.json
# Raw Internet Archive captures read by qs_archive_loader; the manifest pins their sha256.
crawlernest/crawlernest-kb/qs_archive/raw/
crawlernest/crawlernest-kb/qs_universe_resolution_cache.json
crawlernest/crawlernest-kb/qs_universes/**/crawl_meta.json
crawlernest/crawlernest-kb/qs_universes/**/run_status.json
crawlernest/crawlernest-kb/qs_universes/**/raw_snapshot.json
crawlernest/crawlernest-kb/qs_universes/**/normalized_snapshot.json
crawlernest/crawlernest-kb/qs_universes/**/standardized_rows.json

# Model output, not a parity reference. predict_qs_disagreement.m refits
# LogitBoost on every run with no fixed seed, so the probabilities move slightly
# each time; committing it would produce a diff on every re-run that says
# nothing. Everything else under crawlernest-ml/artifacts/ is committed because
# check_matlab_parity compares against it.
crawlernest/crawlernest-ml/artifacts/cross_source_matlab/predicted_disagreements.csv

# Local databases
*.db
*.db.bak
*.sqlite3

# Deprecated diverged copy — the live package is crawlernest/packages/crawlernest_ranking_crawler/ at
# the repo root. This copy was untracked; ignored so searches and tooling skip it.
crawlernest/crawlernest-ranking-crawler/

# Vendored third-party checkout (the "Claw Code" mini-agent), removed from this
# repo: no CrawlerNest code imported it and it shipped without its own LICENSE.
# Ignored so a local checkout placed here is never committed back in.
crawlernest/crawlernest-mini-agent/

# Pipeline export artifacts. Every file here is regenerated:
# `run_pipeline crawl-admission` / `crawl-ranking` write the JSON and JSONL,
# and `ingest-*-staging --write-target sqlite` writes the .sqlite3 stores.
# Nothing in it has ever been tracked. The *.sqlite3 and my_* rules below
# already covered most of the directory; the export files were the gap, so the
# whole directory is ignored rather than chasing each new output name.
crawlernest-samples/

# Personal runtime outputs
my_*.json
my_*.jsonl

# Build outputs
# Local Claude Code state (settings.local.json, worktrees) stays out at every depth; the one tracked file is the
# project's own instructions at the top level. Order matters: the directory is re-included before its contents are
# excluded again, because git cannot re-include a file whose parent directory is excluded.
**/.claude/
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
dist/
build/
*.pyc
*.pyo

# Lobster runtime build outputs — the whole package is regenerated by
# crawlernest/scripts/build_lobster_runtime.sh from crawlernest/. It was
# committed by mistake and has been removed; never commit the built package.
deployment-support/

# Entity-resolution review working files. mapping_review_skeleton.sql
# regenerates the queue from the warehouse, and the decisions themselves live
# in warehouse.mapping_review once applied, so the file in between is scratch.
decisions.csv
decisions.csv.*

# Real secrets for the docker stack; deploy/.env.example is the committed template.
.env
.env.local

# Separate MXC sandbox checkout (lives at ~/dev/mxc now; ignore if re-cloned here)
/mxc/
