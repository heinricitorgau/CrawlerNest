{
  "name": "@crawlernest/marketing-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Routes marketing questions to NotFair and Claude Ads skills, parses their results into pass/fail/unknown/not_applicable findings, and keeps every third-party platform read-only, plus a Claude agent loop that runs a skill on read-only data tools",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./claude": {
      "types": "./dist/src/claude/index.d.ts",
      "default": "./dist/src/claude/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0"
  }
}
