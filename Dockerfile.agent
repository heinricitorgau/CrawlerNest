# The Python agent API, served by Uvicorn.
#
# The app is already ASGI (crawlernest/interfaces/api/agent_api/server.py); this
# image only packages it. Workers come from CRAWLERNEST_AGENT_API_WORKERS, and the
# server refuses more than one unless CRAWLERNEST_AGENT_STORE_BACKEND=postgres --
# with the file backend, two workers would keep two divergent copies of the state.
FROM python:3.12-slim AS runtime
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# psycopg2-binary ships wheels, but curl_cffi and lxml need a compiler on slim.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && apt-get purge -y --auto-remove build-essential

COPY crawlernest ./crawlernest
COPY crawlernest_ranking_crawler ./crawlernest_ranking_crawler
COPY crawlernest_admission_crawler ./crawlernest_admission_crawler
COPY crawlernest_crawler_core ./crawlernest_crawler_core

# State belongs on a volume, not in the container's writable layer, and never in
# /tmp -- a reboot clears /tmp on most systems and takes saved conversations with it.
RUN useradd --system --uid 10002 --home /app crawlernest \
 && mkdir -p /var/lib/crawlernest/agent \
 && chown -R crawlernest:crawlernest /var/lib/crawlernest
ENV CRAWLERNEST_AGENT_STATE_DIR=/var/lib/crawlernest/agent
USER crawlernest

EXPOSE 8090
ENTRYPOINT ["python", "-m", "crawlernest.interfaces.api.agent_api"]
# 0.0.0.0 so the compose network can reach it; the port stays internal unless
# published. Trusted proxies are configured through the environment.
CMD ["--host", "0.0.0.0", "--port", "8090"]
