# Copy to .env and fill in. .env is gitignored; this file is not, so it carries no
# real secret. Every value the stack needs is here -- the images contain none.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=crawlernest
# Generate one, do not reuse: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=clawer
POSTGRES_PORT=5432

# ── Spring Boot read API ──────────────────────────────────────────────────────
API_PORT=8080
# Browser origins allowed to call the API directly with credentials. The frontend
# proxies through its own server routes, so in the compose stack this is only the
# site's public origin. Comma-separated; no wildcard with credentials.
CRAWLERNEST_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Editions the release serves; blank uses the built-in list (2026,2025).
CRAWLERNEST_DATASET_YEARS=

# ── Python agent API ──────────────────────────────────────────────────────────
AGENT_PORT=8090
# postgres keeps agent state in the database, which is what more than one worker
# needs. "file" writes to the state volume and supports a single worker only.
CRAWLERNEST_AGENT_STORE_BACKEND=postgres
CRAWLERNEST_AGENT_API_WORKERS=1
CRAWLERNEST_AGENT_API_LOG_LEVEL=INFO

# ── Next.js frontend ──────────────────────────────────────────────────────────
WEB_PORT=3000
# Only set these if the browser must reach the APIs directly. Left blank, pages
# call the frontend's own /api/* routes, which proxy server-side over the compose
# network -- no API port need be published at all.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AGENT_API_BASE_URL=
