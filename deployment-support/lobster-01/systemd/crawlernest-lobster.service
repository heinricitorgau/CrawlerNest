[Unit]
Description=CrawlerNest Lobster Node Pipeline
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=crawlernest
Group=crawlernest
WorkingDirectory=/opt/lobster-01
ExecStart=/opt/lobster-01/run_lobster.sh --resume
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
