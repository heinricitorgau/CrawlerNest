#!/usr/bin/env bash
# Refreshes the nine local-only files (.repo-diagnostics/ and docs/COMMIT_LOG.md, all gitignored) after each commit,
# in the background so the commit returns at once. Runs no tests. Install once:  ./scripts/install_git_hooks.sh
# Skip:  CRAWLERNEST_SKIP_DIAGNOSTICS=1 git commit ...
ROOT="$(git rev-parse --show-toplevel)"
[ "${CRAWLERNEST_SKIP_DIAGNOSTICS:-}" = "1" ] && exit 0
mkdir -p "$ROOT/.repo-diagnostics"
( "$ROOT/scripts/update_local_docs.sh" --quiet >"$ROOT/.repo-diagnostics/.last-hook-run.log" 2>&1 & ) >/dev/null 2>&1
exit 0
