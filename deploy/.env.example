# Copy to .env and fill in. .env is gitignored; this file is not, so it carries no
# real secret. Every value the stack needs is here -- the images contain none.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=crawlernest
# Generate one, do not reuse: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=clawer
POSTGRES_PORT=5432

# ── Spring Boot read API ──────────────────────────────────────────────────────
API_PORT=8080
# Browser origins allowed to call the API directly with credentials. The frontend
# proxies through its own server routes, so in the compose stack this is only the
# site's public origin. Comma-separated; no wildcard with credentials.
CRAWLERNEST_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Editions the release serves; blank uses the built-in list (2026,2025).
CRAWLERNEST_DATASET_YEARS=
# Signs the auth token. At least 32 bytes: openssl rand -base64 32
# Unset, the API generates a key per process: everyone is signed out on restart
# and a second instance rejects the first one's tokens.
CRAWLERNEST_JWT_SECRET=
# How long a token lasts (ISO-8601 duration). "Sign out everywhere" and a
# password reset end tokens early; otherwise they last this long.
CRAWLERNEST_JWT_TTL=PT12H
# The address the web container listens on. 0.0.0.0 serves the network directly; behind the reverse proxy
# in deploy/nginx/crawlernest.conf.example set 127.0.0.1, so only the proxy reaches it.
WEB_BIND=0.0.0.0
# The site's public address. Reset links point here, and an https value turns
# the cookie's Secure flag on (below).
CRAWLERNEST_PUBLIC_BASE_URL=http://localhost:3000
# auto (default): Secure exactly when CRAWLERNEST_PUBLIC_BASE_URL is https.
# true forces it; false with an https public URL is refused at startup.
CRAWLERNEST_JWT_COOKIE_SECURE=auto
# Proxies whose X-Forwarded-For the API believes, for its per-address rate
# limits (comma separated, CIDR allowed). In this stack the web container is the
# proxy; the default compose network is within 172.16.0.0/12.
CRAWLERNEST_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ── Python agent API ──────────────────────────────────────────────────────────
AGENT_PORT=8090
# postgres keeps agent state in the database, which is what more than one worker
# needs. "file" writes to the state volume and supports a single worker only.
CRAWLERNEST_AGENT_STORE_BACKEND=postgres
CRAWLERNEST_AGENT_API_WORKERS=1
CRAWLERNEST_AGENT_API_LOG_LEVEL=INFO

# ── Next.js frontend ──────────────────────────────────────────────────────────
WEB_PORT=3000
# Only set these if the browser must reach the APIs directly. Left blank, pages
# call the frontend's own /api/* routes, which proxy server-side over the compose
# network -- no API port need be published at all.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_AGENT_API_BASE_URL=
# The site's public origin, e.g. https://crawlernest.example. Set it only for a
# deployment search engines should index: it turns on canonical links, Open Graph
# URLs, sitemap.xml entries and the Sitemap: line in robots.txt. Blank, all of
# those are left out rather than pointed at localhost. Rebuild after changing it.
CRAWLERNEST_SITE_URL=
