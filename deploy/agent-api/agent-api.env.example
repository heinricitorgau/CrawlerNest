# Copy to ~/.config/crawlernest/agent-api.env (chmod 600) and adjust.
# No secret belongs here. The database password goes in ~/.pgpass:
#   localhost:5432:clawer:crawlernest_agent:<password>

CRAWLERNEST_REPO=/home/you/dev/University-Data-Infrastructure-Web-Platform
CRAWLERNEST_PYTHON=/home/you/dev/University-Data-Infrastructure-Web-Platform/.venv/bin/python
PYTHONPATH=/home/you/dev/University-Data-Infrastructure-Web-Platform

CRAWLERNEST_AGENT_API_HOST=127.0.0.1
CRAWLERNEST_AGENT_API_PORT=8090
# More than 1 requires the postgres backend; the server refuses otherwise.
CRAWLERNEST_AGENT_API_WORKERS=2
CRAWLERNEST_AGENT_API_LIMIT_CONCURRENCY=64
CRAWLERNEST_AGENT_API_KEEP_ALIVE_SECONDS=5
CRAWLERNEST_AGENT_API_GRACEFUL_TIMEOUT_SECONDS=30
CRAWLERNEST_AGENT_API_FORWARDED_ALLOW_IPS=127.0.0.1
CRAWLERNEST_AGENT_API_MAX_REQUEST_BYTES=131072
CRAWLERNEST_AGENT_API_LOG_LEVEL=INFO

CRAWLERNEST_AGENT_STORE_BACKEND=postgres
CRAWLERNEST_AGENT_DATABASE_URL=postgresql://crawlernest_agent@localhost:5432/clawer
CRAWLERNEST_AGENT_DB_POOL_MAX=10

# Warehouse reads by the agent's tools (crawlernest/core/services), as a
# read-only role. Interim, until secrets management lands: DatabaseSettings
# passes CRAWLERNEST_PG_PASSWORD explicitly and falls back to "test" when it is
# unset, so ~/.pgpass is NOT consulted for this connection. Set the password
# here and keep this file chmod 600.
CRAWLERNEST_PG_HOST=localhost
CRAWLERNEST_PG_PORT=5432
CRAWLERNEST_PG_DATABASE=clawer
CRAWLERNEST_PG_USER=crawlernest_reader
CRAWLERNEST_PG_PASSWORD=change-me
