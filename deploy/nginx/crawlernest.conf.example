# nginx in front of the CrawlerNest web container -- the only thing that should face the internet.
#
# Why it is needed: the API rate-limits by client address, read from X-Forwarded-For, which it believes only
# from CRAWLERNEST_TRUSTED_PROXIES. Next.js passes on an X-Forwarded-For the visitor sent, so exposed directly
# it lets a visitor pick their own key. Here nginx *replaces* the header with the address it saw, so the chain
# the API reads ends in the real visitor. See docs/AUTH_LIMITATIONS.md, "Rate limiting".
#
# With this in place:
#   - deploy/.env: WEB_BIND=127.0.0.1 (the web container listens on loopback only; the API, agent and database
#     already do), CRAWLERNEST_PUBLIC_BASE_URL=https://crawlernest.example (turns the cookie's Secure flag on)
#     and CRAWLERNEST_CORS_ALLOWED_ORIGINS=https://crawlernest.example.
#   - Only 80 and 443 are open on the host's firewall.
#
# Replace crawlernest.example and the certificate paths. Copy to /etc/nginx/conf.d/crawlernest.conf.

server {
    listen 80;
    server_name crawlernest.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name crawlernest.example;

    ssl_certificate     /etc/letsencrypt/live/crawlernest.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crawlernest.example/privkey.pem;

    # The site's own pages and its /api/* proxy routes; the Spring Boot API is never reached directly.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replaced, not appended: whatever the visitor wrote is dropped.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # The agent page streams explanations over SSE.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
