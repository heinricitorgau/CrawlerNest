# camofox-browser: copy to deploy/camofox.env (gitignored) and fill in.
#
# The server reads this at start-up; nothing here can be changed over its REST API.
#   cd camofox-browser && node --env-file=../deploy/camofox.env server.js
# The session script reads the CAMOFOX_* client lines from the same file:
#   cd crawlernest/crawlernest-camofox-client && npm run build
#   node --env-file=../../deploy/camofox.env dist/src/bin/camofox-session.js init --cookies ~/.camofox/cookies/target.txt

# --- Server ------------------------------------------------------------------

CAMOFOX_PORT=9377

# Required by cookie import (and accepted by the trace routes) once set. Without it,
# cookie import works only from 127.0.0.1 and only when NODE_ENV is not production.
CAMOFOX_API_KEY=
# Optional: when set, every route except /health needs it.
CAMOFOX_ACCESS_KEY=

# Where trace zips are kept until you download them, and for how long. The default
# directory is ~/.camofox/traces; an override must be an absolute path (no ~).
# CAMOFOX_TRACES_DIR=/home/you/.camofox/traces
CAMOFOX_TRACES_TTL_HOURS=24

# --- Proxy -------------------------------------------------------------------
# Leave PROXY_HOST and PROXY_BACKCONNECT_HOST empty to run without a proxy.
#
# With a proxy configured, camofox turns on GeoIP by itself: each browser context
# takes the timezone, locale and geolocation of the proxy's exit IP. There is no
# setting for it. If the GeoIP lookup fails, the server logs a warning and launches
# without it.

# round_robin (the default): rotate over a fixed host and port list.
PROXY_STRATEGY=round_robin
PROXY_PROTOCOL=http
PROXY_HOST=
PROXY_PORT=
# Optional pool instead of PROXY_PORT: 10001,10002,10003 or 10001-10010
PROXY_PORTS=
PROXY_USERNAME=
PROXY_PASSWORD=

# backconnect: one residential gateway; each new browser context gets its own sticky
# session (exit IP). It uses PROXY_BACKCONNECT_HOST/PORT, not PROXY_HOST/PORT. If the
# host, port, username or password is missing, the server starts WITHOUT a proxy and
# does not fail: check that its start-up log says "proxy pool created", not
# "no proxy configured".
# PROXY_STRATEGY=backconnect
# PROXY_PROVIDER=decodo            # decodo rewrites the username per session; generic passes it through
PROXY_BACKCONNECT_HOST=
PROXY_BACKCONNECT_PORT=7000
# Exit-location targeting; only the decodo provider encodes it into the username.
PROXY_COUNTRY=
PROXY_SESSION_DURATION_MINUTES=10

# --- Client (camofox-session script, CamofoxClient) -------------------------

CAMOFOX_URL=http://localhost:9377
CAMOFOX_USER_ID=crawlernest
